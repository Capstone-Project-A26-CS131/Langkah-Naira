# ============================================================
# Langkah Naira — Backend Environment Variables (Example)
# ============================================================

# Server
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Database (PostgreSQL / Neon DB)
DATABASE_URL=postgresql://user:password@endpoint-pooler.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# Neon Branch & Infrastructure
NEON_BRANCH=production
NEON_BRANCH_ID=your_branch_id
NEON_FUNCTION_HOST_SUFFIX=.compute.region.aws.neon.tech

# Neon Object Storage (S3-Compatible)
S3_BUCKET_NAME=uploads
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_ENDPOINT_URL_S3=https://your-branch-id.storage.region.aws.neon.tech
AWS_REGION=us-east-2
